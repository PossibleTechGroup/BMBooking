{
  "name": "bm-admin-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 53400",
    "docker:up": "docker compose -f ../docker-compose.yml up -d --build admin-dashboard backend db",
    "docker:down": "docker compose -f ../docker-compose.yml stop admin-dashboard",
    "docker:logs": "docker compose -f ../docker-compose.yml logs -f admin-dashboard",
    "docker:restart": "docker compose -f ../docker-compose.yml restart admin-dashboard",
    "docker:ps": "docker compose -f ../docker-compose.yml ps admin-dashboard backend",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.8",
    "@reduxjs/toolkit": "^2.2.3",
    "axios": "^1.6.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.378.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-redux": "^9.1.1",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
