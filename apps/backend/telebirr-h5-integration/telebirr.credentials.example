# Copy to telebirr.credentials (filename must NOT end in .env — Prisma scans *.env under backend/)
# cp telebirr.credentials.example telebirr.credentials

BASE_URL=https://developerportal.ethiotelebirr.et:38443/apiaccess/payment/gateway
APP_SECRET=your_app_secret
FABRIC_APP_ID=your_fabric_app_id
MERCHANT_APP_ID=your_merchant_app_id
MERCHANT_CODE=your_merchant_code

# PEM on one line inside double quotes (\n between lines). Do NOT use backticks or bare PEM lines.
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_YOUR_KEY_BODY\n-----END PRIVATE KEY-----"
