# =============================================================================
# ROOT .env — required for Docker (1 of 1 main env files)
# Location:  BMBookingIntegrated/.env  (same folder as docker-compose.yml)
# Create:     cp .env.example .env
# Optional 2nd file: backend/telebirr-h5-integration/.env (Telebirr keys only)
# Do NOT copy this file into admin-dashboard/, reception/, or mobile/ for Docker.
# See: docs/DOCKER-NETWORKING.md
# =============================================================================

# Public URLs — simulators on same PC can use localhost
PUBLIC_API_URL=http://localhost:5000
PUBLIC_TELEBIRR_URL=http://157.180.114.86:53402

# Expo Go on a REAL PHONE — set your laptop Wi-Fi IP
# Find: hostname -I | awk '{print $1}'
# HOST_LAN_IP=192.168.1.50
# EXPO_PUBLIC_LOCAL_IP=192.168.1.50  (or set EXPO_PUBLIC_API_URL directly)
# PUBLIC_API_URL=http://192.168.1.50:5000
# PUBLIC_TELEBIRR_URL=http://157.180.114.86:53402

# --- Backend ---
PORT=5000
NODE_ENV=development

# --- Database (internal service: db) ---
DB_HOST=db
DB_PORT=5432
DB_USER=postgresbmbooking
DB_PASSWORD=vy6H6f9j81c2g0UVdjgjBFyU
DB_NAME=bm_booking_db

# --- Security ---
JWT_SECRET=your_jwt_secret_key_here
OTP_EXPIRY_MINUTES=5

# --- Payments / SMS (optional) ---
CHAPA_SECRET_KEY=
GEEZSMS_TOKEN=
